# Normalise line endings so the repository holds LF regardless of the machine a
# commit was made on. Windows checkouts still get CRLF where the tooling wants
# it, because Git converts on checkout.
* text=auto eol=lf

# Files that must never be converted.
*.png binary
*.ico binary
*.exe binary
*.woff2 binary
*.7z binary
*.zip binary

# Generated by the Wails CLI; collapsed in diffs to keep reviews readable.
frontend/wailsjs/** linguist-generated=true
